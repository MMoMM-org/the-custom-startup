# tcs-git-helpers bad config — malformed / wrong-type values that the parser
# MUST reject (with stderr warning; no abort) per ADR-3.
#
# Each line is a documented rejection case. Drives lib_config_parser.bats
# negative path (T1.4).

# 1. Unknown key (not on allowlist)
EVIL=1

# 2. Boolean expected — got string
TCS_REQUIRE_SCOPE=true

# 3. Boolean expected — got "yes"
TCS_ENABLE_CONVENTIONAL_CHECK=yes

# 4. Integer expected — got string
TCS_MAX_SUBJECT_LENGTH=ninety

# 5. Integer out of range (>9999)
TCS_MAX_SUBJECT_LENGTH=99999

# 6. Integer out of range (0)
TCS_MAX_SUBJECT_LENGTH=0

# 7. Integer with leading sign
TCS_MAX_SUBJECT_LENGTH=-1

# 8. Missing '=' separator (malformed line)
TCS_REQUIRE_SCOPE 1

# 9. Empty key
=somevalue

# 10. Lowercase key (allowlist requires UPPER_SNAKE_CASE)
tcs_require_scope=0

# 11. Key longer than 64 chars (per-line grammar caps key at 64)
TCS_THIS_IS_A_VERY_LONG_KEY_NAME_THAT_EXCEEDS_THE_SIXTYFOUR_CHARACTER_LIMIT=1

# 12. Value longer than 256 chars
TCS_PROTECTED_BRANCHES=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# 13. Misordered (looks like comment without '#')
some random text

# 14. Key with hyphen (not allowed; allowlist is [A-Z][A-Z0-9_]+)
TCS-PROTECTED-BRANCHES=main
