# tcs-git-helpers good config — exercises every allowlisted key
# Drives lib_config_parser.bats (T1.4) success path.
#
# Schema reference: SDD §.githooks/.config Schema

# Pipe-separated list of protected branch names
TCS_PROTECTED_BRANCHES=main|master|production|release

# Path to per-repo exclude-paths file (one glob per line)
TCS_HOOK_EXCLUDE_PATHS_FILE=.githooks/exclude-paths

# Space-separated Conventional Commit types
TCS_ALLOWED_COMMIT_TYPES=feat fix docs style refactor test chore perf revert build ci

# Boolean flags (must be exactly 0 or 1)
TCS_REQUIRE_SCOPE=0
TCS_ENABLE_CONVENTIONAL_CHECK=1
TCS_ENABLE_PR_PUSH_CHECK=1
TCS_ALLOW_AMEND_ON_PROTECTED=0

# Subject-length cap (1-9999)
TCS_MAX_SUBJECT_LENGTH=90

# Quoted values: outer quotes stripped by parser
TCS_PROTECTED_BRANCHES="main|master"

# Single-quoted values
TCS_HOOK_EXCLUDE_PATHS_FILE='.githooks/exclude-paths'

# Trailing comments and surrounding blank lines are tolerated.

