#!/bin/bash
# Mock `gh` CLI for offline testing of tcs-git-helpers (T1.9).
#
# Selects a canned response set via $GH_STUB_SCENARIO (default: "default").
# Real-gh wire format is preserved: `gh pr list --json …` returns an ARRAY
# (`[…]` even when empty, never `null`); `gh pr view --json mergeCommit`
# returns an OBJECT (`{"mergeCommit": {"oid": "…"}}` or `{"mergeCommit": null}`).
#
# Per project-memory feedback "test-stubs-mirror-real-wire-format":
# stubs MUST mirror the real envelope, or production-only bugs slip past green tests.
#
# Usage from tests:
#   PATH="$FIXTURE_DIR/gh_stubs:$PATH" GH_STUB_SCENARIO=closed-pr  gh pr list ...
#
# Scenarios documented in README.md (sibling file).
#
# Exit codes mirror real gh:
#   0  success
#   1  generic failure / no PR found JSON-empty (some flows)
#   4  authentication error / rate limited
# When a scenario maps to a non-zero exit, the wrapper exits accordingly
# AFTER emitting the canned stderr message.
#
# T5.8 extensions for branch-protection:
#   - `gh auth status` echoes a `Token scopes:` line driven by $GH_STUB_SCOPES
#     (csv, default `repo`).
#   - `gh api -X PUT` captures its body to $GH_STUB_CAPTURE_PUT and either
#     succeeds or fails per $GH_STUB_PUT_FAIL.
#   - `gh api .../branches/<b>/protection` GET returns the preset envelope
#     when $GH_STUB_PROTECTION_MATCHES=1; otherwise simulates 404.
#   - `gh api repos/<o>/<r> --jq .default_branch` returns "main".

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
RESP_DIR="$SCRIPT_DIR/responses"
SCENARIO="${GH_STUB_SCENARIO:-default}"

# --- Lookup helpers -------------------------------------------------------

_emit_response() {
  # $1 = operation key (e.g. "pr-list", "pr-view", "api"); prints canned JSON.
  # File path: $RESP_DIR/$SCENARIO/$op.json
  local op="$1"
  local f="$RESP_DIR/$SCENARIO/$op.json"
  if [ -f "$f" ]; then
    cat "$f"
    return 0
  fi
  # Fallback for scenarios that omit a particular op
  local fallback="$RESP_DIR/default/$op.json"
  if [ -f "$fallback" ]; then
    cat "$fallback"
    return 0
  fi
  printf 'gh-stub: no response file for scenario=%s op=%s\n' \
    "$SCENARIO" "$op" >&2
  return 1
}

_emit_failure() {
  # $1 = exit code; $2 = stderr message
  printf '%s\n' "$2" >&2
  exit "$1"
}

# --- Failure scenarios (no JSON; non-zero exit) ---------------------------

case "$SCENARIO" in
  no-auth)
    _emit_failure 4 "error: not authenticated. Run: gh auth login"
    ;;
  rate-limited)
    _emit_failure 4 "error: GraphQL: API rate limit exceeded for installation"
    ;;
  network-fail)
    _emit_failure 1 "error: dial tcp: lookup api.github.com: no such host"
    ;;
  timeout)
    # Simulate a hang the calling timeout wrapper must terminate.
    # For deterministic tests: just exit 124 (matches /usr/bin/timeout).
    _emit_failure 124 "gh-stub: simulated timeout"
    ;;
esac

# --- Subcommand dispatch --------------------------------------------------

if [ "$#" -eq 0 ]; then
  printf 'gh version 2.88.0 (stub-tcs-git-helpers)\n'
  exit 0
fi

case "$1" in
  --version)
    printf 'gh version 2.88.0 (stub-tcs-git-helpers)\n'
    exit 0
    ;;
  pr)
    case "${2:-}" in
      list)
        _emit_response pr-list
        ;;
      view)
        _emit_response pr-view
        ;;
      *)
        printf 'gh-stub: unsupported pr subcommand: %s\n' "${2:-<empty>}" >&2
        exit 2
        ;;
    esac
    ;;
  api)
    # Method/endpoint-aware dispatch for the branch-protection helper (T5.8).
    method="GET"
    endpoint=""
    have_jq_default_branch=0
    body_args=()
    use_stdin=0
    shift  # drop the literal `api`
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -X|--method)
          method="${2:-GET}"; shift 2 ;;
        -X*)
          method="${1#-X}"; shift ;;
        --method=*)
          method="${1#--method=}"; shift ;;
        -f|--raw-field|-F|--field)
          # Capture `-f key=value` pairs to reconstruct a JSON body on PUT.
          body_args+=("${2:-}"); shift 2 ;;
        --input)
          if [ "${2:-}" = "-" ]; then use_stdin=1; fi
          shift 2 ;;
        --jq)
          if [ "${2:-}" = ".default_branch" ]; then have_jq_default_branch=1; fi
          shift 2 ;;
        -H|--hostname)
          shift 2 ;;
        --) shift; break ;;
        -*)
          # Unknown flag — skip silently to stay forward-compatible.
          shift ;;
        *)
          if [ -z "$endpoint" ]; then endpoint="$1"; fi
          shift ;;
      esac
    done
    case "$method" in
      PUT)
        # Capture the request body (stdin or `-f` pairs) for test assertions.
        if [ -n "${GH_STUB_CAPTURE_PUT:-}" ]; then
          if [ "$use_stdin" -eq 1 ]; then
            cat > "$GH_STUB_CAPTURE_PUT"
          else
            # Reconstruct a minimal JSON object from `-f key=value` pairs.
            # `null`/`true`/`false`/numbers stay unquoted; everything else
            # becomes a JSON string.
            {
              printf '{'
              i=0
              for kv in "${body_args[@]}"; do
                k="${kv%%=*}"
                v="${kv#*=}"
                if [ "$i" -gt 0 ]; then printf ','; fi
                printf '"%s":' "$k"
                case "$v" in
                  null|true|false) printf '%s' "$v" ;;
                  ''|*[!0-9]*)     printf '"%s"' "$v" ;;
                  *)               printf '%s' "$v" ;;
                esac
                i=$((i + 1))
              done
              printf '}\n'
            } > "$GH_STUB_CAPTURE_PUT"
          fi
        elif [ "$use_stdin" -eq 1 ]; then
          cat >/dev/null
        fi
        if [ "${GH_STUB_PUT_FAIL:-0}" = "1" ]; then
          printf 'HTTP 422: Validation Failed (stub)\n' >&2
          exit 1
        fi
        printf '{"url":"https://api.github.com/repos/test-user/test-repo/branches/main/protection"}\n'
        exit 0
        ;;
      PATCH)
        if [ "$use_stdin" -eq 1 ]; then cat >/dev/null; fi
        printf '{"delete_branch_on_merge":true}\n'
        exit 0
        ;;
      GET|*)
        case "$endpoint" in
          *"/branches/"*"/protection"*)
            if [ "${GH_STUB_PROTECTION_MATCHES:-0}" = "1" ]; then
              printf '%s\n' '{"required_status_checks":null,"enforce_admins":{"enabled":false},"required_pull_request_reviews":null,"restrictions":null,"allow_force_pushes":{"enabled":false},"allow_deletions":{"enabled":false},"required_linear_history":{"enabled":false},"required_conversation_resolution":{"enabled":false}}'
              exit 0
            fi
            printf 'gh: Branch not protected (HTTP 404)\n' >&2
            exit 1
            ;;
          repos/*)
            if [ "$have_jq_default_branch" -eq 1 ]; then
              printf 'main\n'
              exit 0
            fi
            printf '{"default_branch":"main","name":"test-repo","owner":{"login":"test-user"}}\n'
            exit 0
            ;;
          *)
            _emit_response api
            ;;
        esac
        ;;
    esac
    ;;
  auth)
    case "${2:-}" in
      status)
        # Mirror `gh auth status` output, including a `Token scopes:` line
        # built from $GH_STUB_SCOPES (csv, default `repo`). The
        # branch-protection helper parses this line per integration §9.
        scopes_csv="${GH_STUB_SCOPES:-repo}"
        scopes_quoted="$(printf '%s' "$scopes_csv" \
          | awk -F',' '{
              out = "";
              for (i = 1; i <= NF; i++) {
                if (i > 1) out = out ", ";
                out = out "'\''" $i "'\''";
              }
              print out;
            }')"
        cat <<EOF
github.com
  - Logged in to github.com as test-user (oauth_token)
  - Token: gho_************************************
  - Token scopes: $scopes_quoted
EOF
        exit 0
        ;;
      *)
        printf 'gh-stub: unsupported auth subcommand: %s\n' "${2:-<empty>}" >&2
        exit 2
        ;;
    esac
    ;;
  *)
    printf 'gh-stub: unsupported command: %s\n' "$1" >&2
    exit 2
    ;;
esac
