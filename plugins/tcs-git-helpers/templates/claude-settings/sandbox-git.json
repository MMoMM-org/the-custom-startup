{
  "sandbox": {
    "excludedCommands": [
      "git push *",
      "git fetch *",
      "git pull *",
      "git checkout -b *",
      "git switch -c *",
      "git branch *",
      "git remote *",
      "gh *"
    ],
    "filesystem": {
      "denyWrite": [
        "./.githooks"
      ]
    }
  },
  "permissions": {
    "ask": [
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git remote remove *)",
      "Bash(git remote rename *)"
    ]
  }
}
