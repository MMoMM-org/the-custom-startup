{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ThemeSettings",
  "type": "object",
  "properties": {
    "size": {
      "enum": ["small", "medium", "large"],
      "default": "medium",
      "description": "Widget display size."
    },
    "mode": {
      "type": "string",
      "enum": ["light", "dark"],
      "default": "light",
      "description": "Color theme mode."
    }
  }
}
