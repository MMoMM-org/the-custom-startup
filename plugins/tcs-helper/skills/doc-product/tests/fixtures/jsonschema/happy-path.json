{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppSettings",
  "type": "object",
  "properties": {
    "port": {
      "type": "integer",
      "default": 3000,
      "description": "The port the server listens on."
    },
    "logLevel": {
      "type": "string",
      "default": "info",
      "description": "Logging verbosity level."
    },
    "debug": {
      "type": "boolean",
      "default": false,
      "description": "Enable debug output."
    }
  }
}
