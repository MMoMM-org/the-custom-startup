{
  "schema": 1,
  "credentials": [
    {
      "id": "ssh",
      "path": "~/.ssh",
      "read_rule_spellings": [
        "Read(~/.ssh/**)",
        "Read(~/.ssh)",
        "Read(//{home}/.ssh/**)",
        "Read(//{home}/.ssh)"
      ],
      "sandbox_spellings": [
        "~/.ssh",
        "{home}/.ssh",
        "//{home}/.ssh",
        "~/.ssh/**"
      ],
      "linux_enforceable": true
    },
