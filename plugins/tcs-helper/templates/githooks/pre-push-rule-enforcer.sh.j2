#!/bin/bash
#
# Generated by tcs-helper:rule-enforcer for rule: {{rule_description}}
# Bundle version: see .githooks/tcs-helper-rule-enforcer-version
#
# Pre-push enforcement hook.
#
# Arguments (from git): <remote-name> <remote-url>
# Stdin: one line per ref being pushed:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
#
# Response style: {{response_style}}
#   Block  — prints warning to stderr, exits 1 (push refused)
#   Nudge  — prints warning to stderr, exits 0 (push proceeds)
#
# Install: git config core.hooksPath .githooks
# Then: chmod +x .githooks/pre-push-rule-enforcer-<slug>.sh

set -uo pipefail

# ---------------------------------------------------------------------------
# Walk pushed commits via git rev-list (pre-push contract: read refs from stdin)
# ---------------------------------------------------------------------------

LOCAL_SHA=""
REMOTE_SHA=""

while read -r _ LOCAL_SHA _ REMOTE_SHA; do
  # Skip delete-branch pushes (local sha is all zeros)
  case "$LOCAL_SHA" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  break
done

if [ -z "$LOCAL_SHA" ] || [ -z "$REMOTE_SHA" ]; then
  # Nothing to check (empty push or delete-only)
  exit 0
fi

# Collect commits and changed paths for the pushed range
commits_file="$(mktemp "${TMPDIR:-/tmp}/rule-enforcer-commits.XXXXXX")"
diff_file="$(mktemp "${TMPDIR:-/tmp}/rule-enforcer-diff.XXXXXX")"

git rev-list "$LOCAL_SHA" --not "$REMOTE_SHA" 2>/dev/null > "$commits_file" || true
git diff --name-only "$REMOTE_SHA" "$LOCAL_SHA" 2>/dev/null > "$diff_file" || true

if [ ! -s "$commits_file" ]; then
  # No new commits to check
  rm -f "$commits_file" "$diff_file"
  exit 0
fi

# ---------------------------------------------------------------------------
# Detection: {{rule_description}}
# ---------------------------------------------------------------------------

VIOLATED=0
if {{detection_pattern}}; then
  VIOLATED=1
fi

rm -f "$commits_file" "$diff_file"

if [ "$VIOLATED" -eq 0 ]; then
  exit 0
fi

# ---------------------------------------------------------------------------
# Response: {{response_style}}
# ---------------------------------------------------------------------------

HOOK_STYLE="{{response_style}}"

printf '\n' >&2
printf 'rule-enforcer [%s]: %s\n' "$HOOK_STYLE" "{{warning_message}}" >&2
printf '\n' >&2

if [ "$HOOK_STYLE" = "Block" ]; then
  printf 'Push refused. Resolve the violation and retry.\n' >&2
  exit 1
fi

# Nudge: warning issued above; allow push through
exit 0
